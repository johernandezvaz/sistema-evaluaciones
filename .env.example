# SQLite en desarrollo. La ruta es relativa a prisma/schema.prisma → prisma/dev.db
DATABASE_URL="file:./dev.db"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Primer Superadmin (solo lo usa el comando de alta inicial / seed)
SUPERADMIN_EMAIL="superadmin@empresa.local"
SUPERADMIN_PASSWORD="cambia-esta-contrasena"

# Zona horaria de visualización (la base de datos guarda UTC)
APP_TIMEZONE="America/Mexico_City"

# Contraseña de los usuarios de desarrollo del seed (admin@demo.local, lectura@demo.local)
SEED_PASSWORD="cambia-esta-contrasena"
