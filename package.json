{
  "name": "sistema-evaluaciones-iluo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "tsx scripts/verify-integrity.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "npm run db:check-migrations && vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy && npm run db:integrity",
    "db:migrate:dev": "prisma migrate dev && npm run db:check-migrations && npm run db:integrity",
    "db:integrity": "tsx scripts/apply-integrity.ts && tsx scripts/verify-integrity.ts",
    "db:verify": "tsx scripts/verify-integrity.ts",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:integrity && npm run db:seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@tailwindcss/postcss": "4.1.13",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "tailwindcss": "4.1.13",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.4",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
